{% form 'contact', id: 'SmartboxRedemptionForm' %}

  {% if form.posted_successfully? %}

    <div class="smartbox-success" style="display:block;">
      <h2 class="form-status">
        {{ section.settings.success_message | default: 'Richiesta inviata con successo! Verrai contattato a breve.' }}
      </h2>
    </div>

  {% else %}

    {% if form.errors %}
      <div class="form__message">
        {{ form.errors | default_errors }}
      </div>
    {% endif %}

    <div class="contact__fields">

      <div class="field">
        <input
          type="text"
          name="contact[Codice Smartbox]"
          class="field__input"
          required
          placeholder="{{ section.settings.code_placeholder | default: 'Inserisci il codice Smartbox' }}"
        >
        <label class="field__label">
          {{ section.settings.code_label | default: 'Codice Smartbox' }} *
        </label>
      </div>

      <div class="field">
        <input
          type="email"
          name="contact[email]"
          class="field__input"
          required
          placeholder="{{ section.settings.email_placeholder | default: 'La tua email' }}"
        >
        <label class="field__label">
          {{ section.settings.email_label | default: 'Email' }} *
        </label>
      </div>

    </div>

    <div class="contact__button">
      <button type="submit" class="button">
        {{ section.settings.button_text | default: 'Riscatta Smartbox' }}
      </button>
    </div>

  {% endif %}

{% endform %}