{% doc %}
  @prompt
    Create a replacement logo grid for the existing chosen-by section. Use plain, non-clickable logo images, never buttons or links. Show no visible cards or containers around the logos, no backgrounds, borders, or shadows. Keep a clean responsive grid with consistent logo sizing and spacing. Provide individually editable image pickers so logos can be added, removed, or replaced. When transferring the existing logos, exclude the first and third items in their original order and retain the others. Keep the title and subtitle editable., make the h2 left aligned and give the section more vertical space/padding
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
  .ai-logo-grid-{{ ai_gen_id }} { display:block; width:{{ block.settings.desktop_width_percent }}%; max-width:100%; margin:0 auto; padding-block:{{ block.settings.vertical_padding }}px; color:rgb(var(--color-foreground, 18, 18, 18)); }
  .ai-logo-grid-{{ ai_gen_id }}__heading { text-align:left; margin-bottom:28px; }
  .ai-logo-grid-{{ ai_gen_id }}__title { margin:0 0 8px; font-size:2.4rem; line-height:1.2; }
  .ai-logo-grid-{{ ai_gen_id }}__subtitle { margin:0; font-size:1.5rem; line-height:1.5; }
  .ai-logo-grid-{{ ai_gen_id }}__grid { display:grid; grid-template-columns:repeat({{ block.settings.columns_desktop }},minmax(0,1fr)); align-items:center; justify-items:center; gap:{{ block.settings.logo_gap }}px; }
  .ai-logo-grid-{{ ai_gen_id }}__item { display:flex; width:100%; min-height:{{ block.settings.logo_height }}px; justify-content:center; align-items:center; }
  .ai-logo-grid-{{ ai_gen_id }}__image { display:block; width:100%; max-width:{{ block.settings.logo_max_width }}px; height:{{ block.settings.logo_height }}px; object-fit:contain; }
  @media screen and (max-width:749px) {
    .ai-logo-grid-{{ ai_gen_id }} { width:100%; }
    .ai-logo-grid-{{ ai_gen_id }}__grid { grid-template-columns:repeat({{ block.settings.columns_mobile }},minmax(0,1fr)); gap:{{ block.settings.logo_gap | times: 0.75 | round }}px; }
    .ai-logo-grid-{{ ai_gen_id }}__item,.ai-logo-grid-{{ ai_gen_id }}__image { height:{{ block.settings.mobile_logo_height }}px; min-height:{{ block.settings.mobile_logo_height }}px; }
    .ai-logo-grid-{{ ai_gen_id }}__title { font-size:2rem; }
  }
{% endstyle %}
<div class="ai-logo-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.title != blank or block.settings.subtitle != blank %}<div class="ai-logo-grid-{{ ai_gen_id }}__heading">
    {% if block.settings.title != blank %}<h2 class="ai-logo-grid-{{ ai_gen_id }}__title">{{ block.settings.title | escape }}</h2>{% endif %}
    {% if block.settings.subtitle != blank %}<p class="ai-logo-grid-{{ ai_gen_id }}__subtitle">{{ block.settings.subtitle | escape }}</p>{% endif %}
  </div>{% endif %}
  <div class="ai-logo-grid-{{ ai_gen_id }}__grid" role="list">
    {% for i in (1..6) %}{% assign image_key = 'logo_' | append: i %}{% assign logo = block.settings[image_key] %}{% if logo != blank %}<div class="ai-logo-grid-{{ ai_gen_id }}__item" role="listitem"><img class="ai-logo-grid-{{ ai_gen_id }}__image" src="{{ logo | image_url: width: 600 }}" alt="{{ logo.alt | default: 'Brand logo' | escape }}" loading="lazy" width="{{ logo.width }}" height="{{ logo.height }}"></div>{% endif %}{% endfor %}
  </div>
</div>
{% schema %}
{
  "name": "Chosen by logo grid",
  "settings": [
    {"type":"header","content":"Content"},
    {"type":"text","id":"title","label":"Title","default":"Chosen by"},
    {"type":"text","id":"subtitle","label":"Subtitle","default":"Trusted by leading brands"},
    {"type":"header","content":"Logos"},
    {"type":"image_picker","id":"logo_1","label":"Logo (original item 2)"},
    {"type":"image_picker","id":"logo_2","label":"Logo (original item 4)"},
    {"type":"image_picker","id":"logo_3","label":"Logo (original item 5)"},
    {"type":"image_picker","id":"logo_4","label":"Logo (original item 6)"},
    {"type":"image_picker","id":"logo_5","label":"Logo (original item 7)"},
    {"type":"image_picker","id":"logo_6","label":"Logo (original item 8)"},
    {"type":"header","content":"Layout"},
    {"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},
    {"type":"range","id":"vertical_padding","label":"Vertical padding","min":10,"max":100,"step":10,"unit":"px","default":60},
    {"type":"select","id":"columns_desktop","label":"Columns on desktop","options":[{"value":"3","label":"3"},{"value":"4","label":"4"},{"value":"6","label":"6"}],"default":"4"},
    {"type":"select","id":"columns_mobile","label":"Columns on mobile","options":[{"value":"2","label":"2"},{"value":"3","label":"3"}],"default":"2"},
    {"type":"range","id":"logo_gap","label":"Logo spacing","min":8,"max":48,"step":4,"unit":"px","default":24},
    {"type":"range","id":"logo_max_width","label":"Maximum logo width","min":60,"max":240,"step":10,"unit":"px","default":160},
    {"type":"range","id":"logo_height","label":"Logo height","min":40,"max":120,"step":10,"unit":"px","default":80},
    {"type":"range","id":"mobile_logo_height","label":"Mobile logo height","min":30,"max":90,"step":10,"unit":"px","default":60}
  ],
  "presets":[{"name":"Chosen by logo grid"}],
  "tag":null,
  "class":"chosen-by-logo-grid"
}
{% endschema %}