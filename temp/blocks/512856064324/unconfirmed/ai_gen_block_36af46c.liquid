{% doc %}
  @prompt
    generate a logo grid with the same container constraint and paddings heading styles as the other sections above and below, that can hold logos in lines of 2 or 3 on both desktop and mobile, make the heading not bold
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-logo-grid-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    color: rgb(var(--color-foreground));
  }

  .ai-logo-grid-{{ ai_gen_id }}__inner {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: var(--page-width, 1200px);
    margin: 0 auto;
    padding: {{ block.settings.vertical_padding }}px 5rem;
    box-sizing: border-box;
  }

  .ai-logo-grid-{{ ai_gen_id }}__heading {
    margin: 0 0 3rem;
    font-size: calc(var(--font-heading-scale, 1) * 2.4rem);
    line-height: 1.25;
    font-weight: 400;
    text-align: {{ block.settings.heading_alignment }};
  }

  .ai-logo-grid-{{ ai_gen_id }}__items {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, minmax(0, 1fr));
    gap: {{ block.settings.logo_gap }}px;
    align-items: center;
  }

  .ai-logo-grid-{{ ai_gen_id }}__item {
    display: flex;
    min-width: 0;
    min-height: 90px;
    align-items: center;
    justify-content: center;
  }

  .ai-logo-grid-{{ ai_gen_id }}__item img {
    display: block;
    width: 100%;
    max-width: {{ block.settings.logo_max_width }}px;
    max-height: {{ block.settings.logo_max_height }}px;
    object-fit: contain;
  }

  .ai-logo-grid-{{ ai_gen_id }}__placeholder {
    display: flex;
    width: 100%;
    max-width: {{ block.settings.logo_max_width }}px;
    height: {{ block.settings.logo_max_height }}px;
    align-items: center;
    justify-content: center;
    background: rgba(var(--color-foreground), 0.04);
  }

  .ai-logo-grid-{{ ai_gen_id }}__placeholder svg {
    display: block;
    width: 100%;
    height: 100%;
    color: rgba(var(--color-foreground), 0.35);
  }

  .ai-logo-grid-{{ ai_gen_id }}__empty-state {
    margin: 1rem 0 0;
    color: rgba(var(--color-foreground), 0.7);
    font-size: 1.3rem;
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .ai-logo-grid-{{ ai_gen_id }}__inner {
      width: 100%;
      padding: {{ block.settings.vertical_padding | divided_by: 2 }}px 1.5rem;
    }

    .ai-logo-grid-{{ ai_gen_id }}__items {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, minmax(0, 1fr));
      gap: {{ block.settings.logo_gap | times: 0.75 }}px;
    }

    .ai-logo-grid-{{ ai_gen_id }}__heading {
      margin-bottom: 2rem;
    }

    .ai-logo-grid-{{ ai_gen_id }}__item {
      min-height: 70px;
    }
  }
{% endstyle %}

<div class="ai-logo-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-logo-grid-{{ ai_gen_id }}__inner">
    {% if block.settings.heading != blank %}
      <h2 class="ai-logo-grid-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
    {% endif %}
    <div class="ai-logo-grid-{{ ai_gen_id }}__items">
      {% for i in (1..12) %}
        {% assign logo_key = 'logo_' | append: i %}
        {% assign logo = block.settings[logo_key] %}
        {% if logo != blank %}
          <div class="ai-logo-grid-{{ ai_gen_id }}__item">
            {% if logo.alt != blank %}
              {% assign logo_alt = logo.alt %}
            {% else %}
              {% assign logo_alt = 'Partner logo' %}
            {% endif %}
            <img src="{{ logo | image_url: width: 600 }}" alt="{{ logo_alt | escape }}" loading="lazy" width="{{ logo.width }}" height="{{ logo.height }}">
          </div>
        {% endif %}
      {% endfor %}
      {% if block.settings.show_placeholders %}
        {% assign has_logos = false %}
        {% for i in (1..12) %}
          {% assign logo_key = 'logo_' | append: i %}
          {% if block.settings[logo_key] != blank %}
            {% assign has_logos = true %}
          {% endif %}
        {% endfor %}
        {% unless has_logos %}
          {% for i in (1..6) %}
            <div class="ai-logo-grid-{{ ai_gen_id }}__item">
              <div class="ai-logo-grid-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}</div>
            </div>
          {% endfor %}
        {% endunless %}
      {% endif %}
    </div>
    {% assign has_logos = false %}
    {% for i in (1..12) %}
      {% assign logo_key = 'logo_' | append: i %}
      {% if block.settings[logo_key] != blank %}
        {% assign has_logos = true %}
      {% endif %}
    {% endfor %}
    {% unless has_logos %}
      {% if block.settings.show_placeholders %}<p class="ai-logo-grid-{{ ai_gen_id }}__empty-state">Add logo images in the block settings.</p>{% endif %}
    {% endunless %}
  </div>
</div>

{% schema %}
{
  "name": "Logo grid",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our partners" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "select", "id": "columns_desktop", "label": "Columns on desktop", "options": [{ "value": "2", "label": "2" }, { "value": "3", "label": "3" }], "default": "3" },
    { "type": "select", "id": "columns_mobile", "label": "Columns on mobile", "options": [{ "value": "2", "label": "2" }, { "value": "3", "label": "3" }], "default": "2" },
    { "type": "select", "id": "heading_alignment", "label": "Heading alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }], "default": "left" },
    { "type": "range", "id": "vertical_padding", "label": "Section padding", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "logo_gap", "label": "Logo spacing", "min": 8, "max": 48, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "logo_max_width", "label": "Logo max width", "min": 60, "max": 240, "step": 10, "unit": "px", "default": 160 },
    { "type": "range", "id": "logo_max_height", "label": "Logo max height", "min": 40, "max": 160, "step": 10, "unit": "px", "default": 80 },
    { "type": "checkbox", "id": "show_placeholders", "label": "Show placeholders when empty", "default": true },
    { "type": "header", "content": "Logos" },
    { "type": "image_picker", "id": "logo_1", "label": "Logo 1" },
    { "type": "image_picker", "id": "logo_2", "label": "Logo 2" },
    { "type": "image_picker", "id": "logo_3", "label": "Logo 3" },
    { "type": "image_picker", "id": "logo_4", "label": "Logo 4" },
    { "type": "image_picker", "id": "logo_5", "label": "Logo 5" },
    { "type": "image_picker", "id": "logo_6", "label": "Logo 6" },
    { "type": "image_picker", "id": "logo_7", "label": "Logo 7" },
    { "type": "image_picker", "id": "logo_8", "label": "Logo 8" },
    { "type": "image_picker", "id": "logo_9", "label": "Logo 9" },
    { "type": "image_picker", "id": "logo_10", "label": "Logo 10" },
    { "type": "image_picker", "id": "logo_11", "label": "Logo 11" },
    { "type": "image_picker", "id": "logo_12", "label": "Logo 12" }
  ],
  "presets": [{ "name": "Logo grid" }],
  "tag": null,
  "class": "logo-grid-block"
}
{% endschema %}